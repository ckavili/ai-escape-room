PORT=3000
HOST=127.0.0.1
# Explicit demo mode: no inference calls and no fabricated token counts.
DEMO_MODE=true
# To use real models, set DEMO_MODE=false and configure these:
MAAS_BASE_URL=https://your-maas-host/v1
MAAS_API_KEY=
# Optional: MODELS_CONFIG, DATABASE_PATH, MAAS_TIMEOUT_MS (default 30000)
# Optional model overrides: MAAS_MODEL_FAST, MAAS_MODEL_BALANCED, MAAS_MODEL_PREMIUM
# Set COOKIE_SECURE=true when served over HTTPS.
# Some MaaS installations expose one API root per model:
# MAAS_BASE_URL_FAST=https://your-maas-host/model-a/v1
# MAAS_BASE_URL_BALANCED=https://your-maas-host/model-b/v1
# MAAS_BASE_URL_PREMIUM=https://your-maas-host/model-c/v1
# Per-model API keys can override MAAS_API_KEY via MAAS_API_KEY_FAST, etc.
MAAS_MAX_TOKENS=512

# Streaming Premium requests can need longer than ordinary responses.
MAAS_STREAM_TIMEOUT_MS=120000
